# Production environment contract — copy values into the deployment secret store.
# Do not commit the real .env file.
NODE_ENV=production
PORT=3001
DB_SYNCHRONIZE=false
ENABLE_SWAGGER=false

DB_HOST=database.internal
DB_PORT=5432
DB_USERNAME=greensync
DB_PASSWORD=replace-in-secret-store
DB_NAME=greenoffice

JWT_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com

GEMINI_API_KEY=replace-in-secret-store
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-in-secret-store
SUPABASE_BUCKET=greensync-storage

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-in-secret-store
SMTP_PASS=replace-in-secret-store

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=
